(defcfg
  process-unmapped-keys yes
  danger-enable-cmd yes
  concurrent-tap-hold yes
  rapid-event-delay 10
)

(defsrc
  f1    f2    f3    f4    f5    f6    f7    f8    f9    f10   f11   f12   f13   f14   f15   f16   f17   f18
  fn
  caps  s     d     f     j     k     l
  spc   g     c     b     o     m
)

(defvar
  tap-time 180
  hold-time 230
  ;;cmd-hold-time 270
  double-tap-time 300
)

(deftemplate tap-hold-key (key mod)
  (tap-hold-release-keys
    $tap-time
    $hold-time
    (multi $key)
    $mod
    (s d f j k l)
  )
)

(defalias
  fnl (tap-hold 200 200 fn (layer-toggle fn-layer))

  ;;a (tap-hold-release-keys $tap-time $hold-time a lsft (a s d f j k l ;))
  s (tap-hold-tap-keys $tap-time $hold-time s lctl (a s d f j k l ;))
  d (tap-hold-tap-keys $tap-time $hold-time d lalt (a s d f j k l ;))
  f (tap-hold-tap-keys $tap-time $hold-time f lmet (a s d f j k l ;))
  j (tap-hold-tap-keys $tap-time $hold-time j rmet (a s d f j k l ;))
  k (tap-hold-tap-keys $tap-time $hold-time k ralt (a s d f j k l ;))
  l (tap-hold-tap-keys $tap-time $hold-time l rctl (a s d f j k l ;))
  ;;; (tap-hold-release-keys $tap-time $hold-time ; rsft (a s d f j k l ;))

  caps (tap-hold 200 200 esc lctl)

  ;; Private ZMK punctuation signals. Unicode output bypasses macOS input source.
  zmk-comma (unicode U+002C)
  zmk-question (unicode U+003F)
  zmk-dot (unicode U+002E)
  zmk-slash (unicode U+002F)
  zmk-apostrophe (unicode U+0027)
  zmk-double-quote (unicode U+0022)

  ;; spc (tap-hold-release-keys 150 200 spc (layer-while-held leader) (s d f j k l))
)

(deflayer base
  brdn  brup  _     _     _     _     prev  pp    next  mute  vold  volu
  ;; F13             F14           F15       F16         F17              F18
  @zmk-comma         @zmk-question @zmk-dot  @zmk-slash  @zmk-apostrophe  @zmk-double-quote
  @fnl
  @caps @s    @d    @f    @j    @k    @l
  spc   g     c     b     o     m
)

(deflayer fn-layer
  f1    f2    f3    f4    f5    f6    f7    f8    f9    f10   f11   f12
  ;; F13             F14           F15       F16         F17              F18
  @zmk-comma         @zmk-question @zmk-dot  @zmk-slash  @zmk-apostrophe  @zmk-double-quote
  _
  _     _     _     _     _     _     _     _     _
  _     _     _     _
)

