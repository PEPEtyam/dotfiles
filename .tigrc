# Tig — приглушённая палитра под тему Gruvbox Material Alabaster
# (см. ~/.config/helix/themes/alabaster_gruvbox_material_dark_soft.toml).
#
# Базовые имена цветов (red/green/yellow/blue/magenta/cyan) берутся из
# активной темы терминала (ghostty), а не захардкожены хексами — так они
# остаются согласованными при смене темы терминала и не выглядят "ярко":
# в ghostty эти слоты уже приглушены под грувбокс/хеликс.

set git-colors = no

color default                  default default
# fg зафиксирован явно, иначе на строке с диффом (+/-) курсор наследует
# цвет содержимого (зелёный/красный) и выглядит слишком ярко
color cursor                   white   default bold
color status                   default default

# Общий "cursor" не всегда перекрывает встроенные дефолты конкретных
# видов (например, diff/stage-панель всё ещё зеленела при переходе на
# коммит) — фиксируем то же самое явно по каждому виду.
color main.cursor              white   default bold
color diff.cursor              white   default bold
color blame.cursor             white   default bold
color stage.cursor             white   default bold
color log.cursor               white   default bold
color refs.cursor              white   default bold
color stash.cursor             white   default bold
color grep.cursor              white   default bold
color pager.cursor             white   default bold

# "blue" в активной теме терминала переопределён под фиолетовый (см.
# gruvbox_material_alabaster.conf), поэтому статусная строка красится тут
# явным серым (color8), а не именованным цветом
color title-focus              white   color8
color title-blur               color8  default

# Diff
color diff-header              blue    default
color diff-index               blue    default
color diff-chunk               magenta default
color diff-stat                default default
color diff-add                 green   default
color diff-add2                green   default
color diff-del                 red     default
color diff-del2                red     default
color diff-add-highlight       green   default bold
color diff-del-highlight       red     default bold
color diff-oldmode             yellow  default
color diff-newmode             yellow  default

# Pretty-printed commit headers
color pp-refs                  yellow  default
color pp-merge                 magenta default

# Main view
color graph-commit             yellow  default
color main-commit               default default
color main-annotated             default default
color main-head                  green   default bold
color main-remote                green   default
color main-tracked               green   default bold
color main-tag                   yellow  default bold
color main-local-tag             yellow  default
color main-ref                   blue    default
color main-replace                red    default
color main-stash                 magenta default
color main-other                  default default

# Status view
color stat-staged                green  default
color stat-unstaged              yellow default
color stat-untracked             red    default

# Help
color help-group                blue   default bold
color help-action               default default

# Tree
color tree.directory            blue   default
color tree.file                 default default
